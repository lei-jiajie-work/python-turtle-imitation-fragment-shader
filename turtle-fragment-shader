from turtle import *
import math

def saw_wave(x):
    return math.fmod(x, 1.0)

def clamp(a, b, c):
    return min(max(a, b), c)

class Vec2:
    def __init__(self, x, y):
        self.x = float(x)
        self.y = float(y)

    def get_length(self):
        return math.sqrt(self.x * self.x + self.y * self.y)

    def get_angle(self):
        return math.atan(self.y / self.x)

    def get_normalized(self):
        normalized_x = self.x / self.get_length()
        normalized_y = self.y / self.get_length()
        return Vec2(normalized_x, normalized_y)

    @staticmethod
    def from_angle(angle):
        height = sin(angle)
        length = cos(angle)
        return Vec2(length, height)
    
    def subtract(self, b):
        self.x -= b.x,
        self.y -= b.y,

    def subtract_scalar(self, scalar):
        self.x -= scalar
        self.y -= scalar
    
    def add(self, b):
        self.x += b.x,
        self.y += b.y,
    
    def add_scalar(self, scalar):
        self.x += scalar
        self.y += scalar
    
    def abs(self):
        self.x = math.abs(self.x)
        self.y = math.abs(self.y)

    @staticmethod
    def max(a, b):
        return Vec2(
            math.max(a.x, b.x),
            math.max(a.y, b.y),
        )
    
    @staticmethod
    def min(a, b):
        return Vec2(
            math.min(a.x, b.y),
            math.min(a.x, b.y),
        )

class Vec3:
    # I wish I had pointers for x, y, and z
    def __init__(self, r, g, b):
        self.r = float(r)
        self.g = float(g)
        self.b = float(b)
    
    def subtract(self, b):
        self.r -= b.r,
        self.g -= b.g,
        self.b -= b.b,
    
    def subtract_scalar(self, scalar):
        self.r -= scalar
        self.g -= scalar
        self.b -= scalar
    
    def add(self, b):
        self.r += b.r,
        self.g += b.g,
        self.b += b.b,
    
    def add_scalar(self, scalar):
        self.r += scalar
        self.g += scalar
        self.b += scalar

    def divide(self, b):
        self.r /= b.r
        self.g /= b.g
        self.b /= b.b
    
    def divide_scalar(self, scalar):
        self.r /= scalar
        self.g /= scalar
        self.b /= scalar

    def multiply(self, b):
        self.r *= b.r
        self.g *= b.g
        self.b *= b.b
    
    def multiply_scalar(self, scalar):
        self.r *= scalar
        self.g *= scalar
        self.b *= scalar
    
    def abs(self):
        self.r = math.abs(self.r)
        self.g = math.abs(self.g)
        self.b = math.abs(self.b)
    
    def get_length(self):
        return math.sqrt(self.r * self.r + self.g * self.g + self.b * self.b)
    
    def floor(self):
        self.r = math.floor(self.r)
        self.g = math.floor(self.g)
        self.b = math.floor(self.b)
    
    @staticmethod
    def max(a, b):
        return Vec3(
            math.max(a.r, b.r),
            math.max(a.g, b.g),
            math.max(a.b, b.b),
        )
    
    @staticmethod
    def min(a, b):
        return Vec3(
            math.min(a.r, b.r),
            math.min(a.g, b.g),
            math.min(a.b, b.b),
        )

# 160, 90 is best compromise between render-speed and quality
