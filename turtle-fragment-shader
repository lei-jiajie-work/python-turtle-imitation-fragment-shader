# p and b are Vec3s
def signed_distance_box(p, b):
    q = p.abs().subtract(b)
    return Vec3.max(q, Vec3(0.0, 0.0, 0.0)).get_length() \
    + min(max(q.r, max(q.g, q.b)), 0.0)

# p is a vector 3, interval is a float
def domain_repetition(p, interval):
    id = p.divide_scalar(interval).add_scalar(0.5).floor()
    r = p.subtract(id.multiply_scalar(interval))
    rand_size = Vec2(1.0, 1.0).add_scalar(math.sin(id.r * 4.2 - id.g * 9.1))
    pillars = signed_distance_box(
        Vec3(r.r, p.g + rand_size.y, r.b),
        Vec3(PILLAR_SIZE.r, PILLAR_SIZE.g, PILLAR_SIZE.b),
    )
    
    return pillars

# p is a vector 3
def map(p):
    pillars = domain_repetition(p.subtract(Vec3(6.0, 1.0, -1.0)), 12.0)
    ground = -1.0 * (p.g - 2.5)
    return min(ground, pillars)

def frag(frag_coord):
    uv = frag_coord.divide(SCREEN_SIZE)
    #uv = Vec2(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0)
    uv = uv.multiply_scalar(2.0).subtract_scalar(1.0)
    uv.x = uv.x * (float(SCREEN_SIZE.x) / float(SCREEN_SIZE.y))
    
    ray_origin = Vec3(0.0, 0.0, -3.0)
    ray_direction = Vec3(uv.x, uv.y, 1.0).get_normalized()
    travel = 0.0
    tint = Vec3(0.3, 0.5, 0.3)
    color = Vec3(0.0, 0.0, 1.0)

    for i in range(MARCHES):
        position = ray_origin.add(ray_direction.multiply_scalar(travel))
        
        distance = float(map(position))
        
        travel += distance
                
        if (distance < MIN_RENDER_DISTANCE) or (distance > MAX_RENDER_DISTANCE):
            break

    travel /= 80.0
    
    color = Vec3(travel, travel, travel)
    color = color.multiply(tint)
    color = Vec3.min(Vec3.max(color, Vec3(0.0, 0.0, 0.0)), Vec3(1.0, 1.0, 1.0))
        
    return color

def draw():
    for y_pixel in range(1, int(SCREEN_SIZE.y)):
        for x_pixel in range(1, int(SCREEN_SIZE.x)):
            frag_coord = Vec2(float(x_pixel), float(y_pixel))
            COLOR = frag(frag_coord)
            pen.teleport(frag_coord.x, frag_coord.y)
            pen.color(COLOR.r, COLOR.g, COLOR.b)
            pen.stamp()

while run_simulation:
    pen.clearstamps()
    draw()
    update()
    frame += 1
