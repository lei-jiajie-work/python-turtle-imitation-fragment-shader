frame_dilation = 4.0

def signed_distance_box(p, b):
    # p and b are Vec3s
    q = p.abs().subtract(b)
    u = math.min(math.max(q.r, math.max(q.g, q.b)), 0.0)
    return Vec3.max(q, Vec3(0, 0, 0)).get_length().add_scalar(u)

def domain_repetition(p, interval):
    # p is a vector 3, interval is a float
    
    id = p.divide(interval / 0.5).floor()
    r = p.subtract(id.multiply_scalar(interval))
    
    rand_size = Vec2(1.0, 1.0).add_scalar(math.sin(id.x * 4.2 - id.y * 9.1))
    pillars = signed_distance_box(
        Vec3(r.x, p.y + rand_size.y, r.z),
        Vec3(PILLAR_SIZE.x, PILLAR_SIZE.y, PILLAR_SIZE.z),
    )
    
    return pillars

# I believe the colors might not be too accurate, because I don't know if the dot is centered on the pen's location or not.
def frag(frag_coord):
    COLOR = Vec3(0.2, 0.5, 1)
    uv = Vec2(float(frag_coord.x) / SCREEN_SIZE.x, float(frag_coord.y) / SCREEN_SIZE.y)
    
    uv = Vec2(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0)
    
    uv.x *= (float(SCREEN_SIZE.x) / float(SCREEN_SIZE.y))
    
    uv.x += math.cos(frame * PI / frame_dilation) * ZOOM
    uv.y += math.sin(frame * PI / frame_dilation) * ZOOM
    
    inverse_length = 1.0 - min(uv.get_length(), 1.0)
    #inverse_length += 0.2
    inverse_length *= inverse_length
    #inverse_length *= (float(math.sin(frame * PI / frame_dilation)) + 1.0) / 2.0
    
    COLOR = Vec3(
        clamp(COLOR.r * inverse_length, 0.0, 1.0), 
        clamp(COLOR.g * inverse_length, 0.0, 1.0), 
        clamp(COLOR.b * inverse_length, 0.0, 1.0),
    )
    
    return COLOR

def draw():
    for y_pixel in range(1, int(SCREEN_SIZE.y)):
        for x_pixel in range(1, int(SCREEN_SIZE.x)):
            frag_coord = Vec2(x_pixel, y_pixel)
            COLOR = frag(frag_coord)
            pen.teleport(frag_coord.x, frag_coord.y)
            pen.color(COLOR.r, COLOR.g, COLOR.b)
            pen.stamp()

#print(Vec3.__dict__)

while True:
    pen.clearstamps()
    draw()
    update()
    frame += 1
