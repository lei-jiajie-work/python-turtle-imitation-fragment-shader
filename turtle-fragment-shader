class Vec2:
    def __init__(self, x, y):
        self.x = float(x)
        self.y = float(y)

    def get_length(self):
        return math.sqrt(self.x * self.x + self.y * self.y)
    
    def get_normalized(self):
        normalized_x = self.x / self.get_length()
        normalized_y = self.y / self.get_length()
        return Vec2(normalized_x, normalized_y)
    
    def subtract(self, b):
        return Vec2(
            self.x - b.x,
            self.y - b.y,
        )

    def subtract_scalar(self, scalar):
        return Vec2(
            self.x - float(scalar),
            self.y - float(scalar),
        )
    
    def add(self, b):
        return Vec2(
            self.x + b.x,
            self.y + b.y,
        )
    
    def add_scalar(self, scalar):
        return Vec2(
            self.x + float(scalar),
            self.y + float(scalar),
        )
    
    def divide(self, b):
        return Vec2(
            self.x / b.x,
            self.y / b.y,
        )

    def divide_scalar(self, scalar):
        return Vec2(
            self.x / scalar,
            self.y / scalar,
        )

    def multiply(self, b):
        return Vec2(
            self.x * b.x,
            self.y * b.y,
        )

    def multiply_scalar(self, scalar):
        return Vec2(
            self.x * scalar,
            self.y * scalar,
        )
    
    def abs(self): 
        return Vec2(
            float(abs(self.x)),
            float(abs(self.y)),
        )
    
    @staticmethod
    def max(a, b):
        return Vec2(
            max(a.x, b.x),
            max(a.y, b.y),
        )
    
    @staticmethod
    def min(a, b):
        return Vec2(
            min(a.x, b.y),
            min(a.x, b.y),
        )

class Vec3:
    # I wish I had pointers for x, y, and z
    def __init__(self, r, g, b):
        self.r = float(r)
        self.g = float(g)
        self.b = float(b)
    
    def subtract(self, b):
        return Vec3(
            self.r - b.r,
            self.g - b.g,
            self.b - b.b,
        )
    
    def subtract_scalar(self, scalar):
        return Vec3(
            self.r - float(scalar),
            self.g - float(scalar),
            self.b - float(scalar),
        )
    
    def add(self, b):
        return Vec3(
            self.r + b.r,
            self.g + b.g,
            self.b + b.b,
        )
    
    def add_scalar(self, scalar):
        return Vec3(
            self.r + float(scalar),
            self.g + float(scalar),
            self.b + float(scalar),
        )

    def divide(self, b):
        return Vec3(
            self.r / b.r,
            self.g / b.g,
            self.b / b.b,
        )
    
    def divide_scalar(self, scalar):
        return Vec3(
            self.r / float(scalar),
            self.g / float(scalar),
            self.b / float(scalar),
        )

    def multiply(self, b):
        return Vec3(
            self.r * b.r,
            self.g * b.g,
            self.b * b.b,
        )
    
    def multiply_scalar(self, scalar):
        return Vec3(
            self.r * float(scalar),
            self.g * float(scalar),
            self.b * float(scalar),
        )
    
    def get_length(self):
        return float(math.sqrt(self.r * self.r + self.g * self.g + self.b * self.b))
    
    def get_normalized(self):
        return Vec3(
            self.r / float(self.get_length()),
            self.g / float(self.get_length()),
            self.b / float(self.get_length()),
        )
    
    def abs(self):
        return Vec3(
            float(abs(self.r)),
            float(abs(self.g)),
            float(abs(self.b)),
        )
    
    def floor(self):
        return Vec3(
            float(math.floor(self.r)),
            float(math.floor(self.g)),
            float(math.floor(self.b)),
        )
    
    @staticmethod
    def max(a, b):
        return Vec3(
            max(a.r, b.r),
            max(a.g, b.g),
            max(a.b, b.b),
        )
    
    @staticmethod
    def min(a, b):
        return Vec3(
            min(a.r, b.r),
            min(a.g, b.g),
            min(a.b, b.b),
        )

# 160, 90 is best compromise between render-speed and quality
# 48, 27 isn't bad
SCREEN_SIZE = Vec2(240, 135)
WINDOW_SIZE = Vec2(1920, 1080)
ZOOM = 0.4
FRAGMENT_SIZE_MODIFIER = 0.0475
PI = 3.14159
TAU = 6.28318
MARCHES = 80
MAX_RENDER_DISTANCE = 200.0
MIN_RENDER_DISTANCE = 0.015625
PILLAR_SIZE = Vec3(1.0, 13.0, 1.0)

